{"version": 2, "width": 104, "height": 46, "timestamp": 1785419127, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "ProvenancePipeline: a cluster refusing an unsigned image"}
[1.239729, "o", "\r\n\u001b[2m# The policy is in Enforce, and the webhook fails closed.\u001b[0m\r\n\u001b[1m$ sudo kubectl --kubeconfig=/etc/kubernetes/admin.conf get clusterpolicy verify-provenance -o jsonpath='{.spec.rules[*].verifyImages[*].failureAction}{\"\\n\"}'\u001b[0m\r\n"]
[1.300548, "o", "Enforce Enforce\r\n"]
[1.3038, "o", "\u001b[1m$ sudo kubectl --kubeconfig=/etc/kubernetes/admin.conf get clusterpolicy verify-provenance -o jsonpath='{.spec.webhookConfiguration.failurePolicy}{\"\\n\"}'\u001b[0m\r\n"]
[1.3731, "o", "Fail\r\n"]
[1.377008, "o", "\r\n\u001b[2m# 1/4  Our image, by digest, signed by the release workflow.\u001b[0m\r\n\u001b[1m$ kubectl apply -f - <<< \"pod signed using ghcr.io/pontope/provenancepipeline@sha256:5d4b03eae45558381b0236be7cacf0cf67d33a3711fb50ec8ab84a0efc692ea4\"\u001b[0m\r\n"]
[1.497181, "o", "\u001b[32mpod/signed created\u001b[0m\r\n"]
[7.499949, "o", "\u001b[1m$ sudo kubectl --kubeconfig=/etc/kubernetes/admin.conf get pod signed -n provenance-demo -o wide\u001b[0m\r\n"]
[7.555156, "o", "NAME     READY   STATUS    RESTARTS   AGE   IP               NODE           NOMINATED NODE   READINESS GATES\r\nsigned   1/1     Running   0          6s    10.244.220.162   kate-node-01   <none>           <none>\r\n"]
[7.558301, "o", "\r\n\u001b[2m# 2/4  An ordinary public image. Nothing wrong with it — it just is not ours.\u001b[0m\r\n\u001b[1m$ kubectl apply -f - <<< \"pod unsigned using docker.io/library/busybox@sha256:9532d8c39891ca2ecde4d30d7710e01fb739c87a8b9299685c63704296b16028\"\u001b[0m\r\n"]
[8.298605, "o", "\u001b[31mError from server: error when creating \"STDIN\": admission webhook \"mutate.kyverno.svc-fail\" denied the request: \r\n\r\nresource Pod/provenance-demo/unsigned was blocked due to the following policies \r\n\r\nverify-provenance:\r\n  deny-unsigned-in-enforced-namespaces: 'failed to verify image docker.io/library/busybox@sha256:9532d8c39891ca2ecde4d30d7710e01fb739c87a8b9299685c63704296b16028:\r\n    .attestors[0].entries[0].keyless: sigstore bundle verification failed: no matching\r\n    signatures found'\u001b[0m\r\n\r\n\u001b[2m# 3/4  Genuinely Sigstore-signed, by the Kyverno release workflow.\u001b[0m\r\n\r\n\u001b[2m#      A signature is not enough. It has to be OUR signature.\u001b[0m\r\n"]
[8.298661, "o", "\u001b[1m$ kubectl apply -f - <<< \"pod other-identity using reg.kyverno.io/kyverno/kyverno@sha256:0a540e2ddf74d0d2d3d45f9ef248d7dbc96576accdbcc6a2dd7eaff9fea56504\"\u001b[0m\r\n"]
[12.855792, "o", "\u001b[31mError from server: error when creating \"STDIN\": admission webhook \"mutate.kyverno.svc-fail\" denied the request: \r\n\r\nresource Pod/provenance-demo/other-identity was blocked due to the following policies \r\n\r\nverify-provenance:\r\n  deny-unsigned-in-enforced-namespaces: 'failed to verify image reg.kyverno.io/kyverno/kyverno@sha256:0a540e2ddf74d0d2d3d45f9ef248d7dbc96576accdbcc6a2dd7eaff9fea56504:\r\n    .attestors[0].entries[0].keyless: sigstore bundle verification failed: no matching\r\n    signatures found'\u001b[0m\r\n\r\n\u001b[2m# 4/4  Our image, our signature, referenced by tag instead of digest.\u001b[0m\r\n\r\n\u001b[2m#      The signature covers a digest. A tag is a mutable pointer to one.\u001b[0m\r\n"]
[12.855824, "o", "\u001b[1m$ kubectl apply -f - <<< \"pod tagged using ghcr.io/pontope/provenancepipeline:latest\"\u001b[0m\r\n"]
[12.956252, "o", "\u001b[31mError from server: error when creating \"STDIN\": admission webhook \"validate.kyverno.svc-fail\" denied the request: \r\n\r\nresource Pod/provenance-demo/tagged was blocked due to the following policies \r\n\r\nverify-provenance:\r\n  deny-unsigned-in-enforced-namespaces: missing digest for ghcr.io/pontope/provenancepipeline:latest\r\n  verify-own-images: missing digest for ghcr.io/pontope/provenancepipeline:latest\u001b[0m\r\n\r\n\u001b[2m# The provenance the cluster just enforced, read back from the registry:\u001b[0m\r\n"]
[12.956384, "o", "\u001b[1m$ cosign verify-attestation --type slsaprovenance1 \\\r\n    --certificate-identity 'https://github.com/PontoPe/ProvenancePipeline/.github/workflows/release.yml@refs/heads/main' \\\r\n    --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' \\\r\n    ghcr.io/pontope/provenancepipeline@sha256:5d4b03eae45558381b0236be7cacf0cf67d33a3711fb50ec8ab84a0efc692ea4 2>/dev/null \\\r\n  | jq -r '.payload | @base64d | fromjson | .predicate\r\n      | {buildType: .buildDefinition.buildType,\r\n         builder: .runDetails.builder.id,\r\n         invocation: .runDetails.metadata.invocationId}'\u001b[0m\r\n"]
[17.378638, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"buildType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"https://github.com/PontoPe/ProvenancePipeline/build-types/github-actions/v1\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"builder\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"https://github.com/PontoPe/ProvenancePipeline/.github/workflows/release.yml@refs/heads/main\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"invocation\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"https://github.com/PontoPe/ProvenancePipeline/actions/runs/30470283063/attempts/1\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"buildType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"https://actions.github.io/buildtypes/workflow/v1\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"builder\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"https://github.com/PontoPe/ProvenancePipeline/.github/workflows/release.yml@refs/heads/main\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"invocation\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"https://github.com/PontoPe/ProvenancePipeline/actions/runs/30470283063/attempts/1\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[17.380995, "o", "\r\n\u001b[2m# One pod running. Three refused, before anything was pulled or executed.\u001b[0m\r\n\u001b[1m$ sudo kubectl --kubeconfig=/etc/kubernetes/admin.conf get pods -n provenance-demo\u001b[0m\r\n"]
[17.437054, "o", "NAME     READY   STATUS    RESTARTS   AGE\r\nsigned   1/1     Running   0          15s\r\n"]
